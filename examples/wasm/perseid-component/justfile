# Build the Perseid step component (ADR-0075): src/main.ts -> a wasm component
# exporting perseid:reconcile/step against `world perseid` (wit/world.wit).
#
#     just build [out]        default out: perseid-component.wasm (gitignored)
#
# ═══════════════════════════════════════════════════════════════════════════
# ***THIS EXISTED AS TWO COMMANDS IN SOMEBODY'S HEAD AND THAT MADE A TEST
# UNCOLD-STARTABLE.*** trail's step-linker test - the only test in the tree that
# instantiates the perseid world against a REAL artifact - needs this .wasm, and
# for a while nothing in the repo produced it: green on the machine of whoever
# had built it, red on every clean tree (CLAUDE.md's cold-start reflex, verbatim:
# "a check that requires the state its own SUCCESS creates cannot cold-start").
# The producer is this recipe; cmd/trail/tests/fixtures/justfile calls it, so a
# fresh worktree builds the artifact inside `cargo test`. Was build.sh; ported to
# just on engi's call, 2026-09-02.
# ═══════════════════════════════════════════════════════════════════════════

set shell := ["bash", "-euo", "pipefail", "-c"]

here := justfile_directory()

# Same discovery order as ../js-dwarf-checkpoint-also-run/build.sh: PATH, then
# ~/git/dwarf/target/{release,debug}.
dwarf := env("DWARF_BIN", `command -v dwarf || { [ -x "$HOME/git/dwarf/target/release/dwarf" ] && echo "$HOME/git/dwarf/target/release/dwarf"; } || { [ -x "$HOME/git/dwarf/target/debug/dwarf" ] && echo "$HOME/git/dwarf/target/debug/dwarf"; } || echo ""`)

default: build

# vite (esnext) then dwarf. --world perseid-signalling is named explicitly: the same wit also
# declares provider, partial-provider and driver, and the wrong one produces a
# component that links and does nothing.
build out="perseid-component.wasm":
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{here}}"
    [ -n "{{dwarf}}" ] || { echo "error: dwarf binary not found on PATH or at ~/git/dwarf/target/{release,debug}/dwarf" >&2; echo "       build it: cd ~/git/dwarf && cargo build --release" >&2; exit 1; }
    echo "1/2 vite build (esnext): src/main.ts -> dist/main.js"
    bunx vite build
    echo "2/2 dwarf componentize -> {{out}}"
    "{{dwarf}}" --wit wit --js dist/main.js --world perseid-signalling -o "{{out}}"
    # THE INPUTS' HASH, NOT ONLY THE OUTPUT'S (radiant-main): dwarf cannot report
    # its own version by any flag, so an output-only comparison cannot tell
    # "inputs changed" from "the toolchain moved". Two hashes make a mismatch
    # attributable. Sorted, content-only, so the digest is stable across
    # filesystem ordering and mtimes.
    inputs=$({ sha256sum src/main.ts; find wit -type f -name '*.wit' -print0 | sort -z | xargs -0 sha256sum; } | sha256sum | cut -d' ' -f1)
    # ⚠ The world is written from a LITERAL and said `perseid` for one commit
    # after the build moved to `perseid-signalling` - a manifest describing an
    # artifact it no longer describes. Kept in step with the --world flag above.
    printf 'output_sha256=%s\ninputs_sha256=%s\nworld=perseid-signalling\n' "$(sha256sum "{{out}}" | cut -d' ' -f1)" "$inputs" > "{{out}}.manifest"
    echo "built {{out}} ($(du -h "{{out}}" | cut -f1)) - exports perseid:reconcile/step; manifest: {{out}}.manifest"
