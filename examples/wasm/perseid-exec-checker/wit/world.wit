package example:perseid-exec-checker;

/// The POLICY half of the perseid-exec pair.
///
/// It imports nothing special because it is only ever the thing being spawned:
/// trail wires its stdin/stdout to the duplex pipe halves (`exec.rs`'s
/// `build_child_store`), so plain stdio is the whole interface. Same shape as
/// `demo:exec-child`'s `echo` world for exactly that reason.
world checker {
  export wasi:cli/run@0.3.0;
}
