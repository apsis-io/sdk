package periapsis:host@0.1.0;

/// Explicit, allowlisted child-component spawning - complementary to the magic
/// seam (periapsis:magic/handler, wit/magic/magic.wit), not a replacement for
/// it. The seam composes another component's FUNCTION interface at launch time
/// (dynamic linking); this is a genuine subprocess LIFECYCLE - spawn, pipe
/// stdio, wait for an exit code - modeled as a fresh, fully isolated wasmtime
/// Store/instance per child (the same per-request isolation `trail --serve`
/// already uses), never shared memory with the parent or with other children.
///
/// Matches Trail's fail-closed philosophy (--host-caps, --link,
/// --rootfs): a guest can only spawn a NAME declared at pod-launch time via
/// `--exec-with <name>=<path>`. There is no way to name an arbitrary host path
/// or program from inside the guest - spawning an undeclared name is always
/// `not-allowed`, never a lookup against the filesystem or a package registry.
///
/// Requires WASI 0.3 (component-model-async): `stream<u8>` and `wait`'s
/// `async func` are only meaningful under trail's `--p3` run path.
interface exec {
  enum exec-error {
    /// `name` was not declared via --exec-with at launch.
    not-allowed,
    /// The declared component failed to load or instantiate.
    spawn-failed,
    /// The child has already exited; this handle can no longer be used.
    exited,
  }

  /// A running (or exited) child component instance.
  resource child-process {
    /// Spawn `name` (must be pre-declared via --exec-with) with `args`,
    /// feeding it `stdin` as its wasi:cli/stdin. The caller creates the
    /// stream pair itself (as with wasi:http/types@0.3.0's Response.new
    /// taking `contents` as a param) and keeps the writable half to feed the
    /// child over its lifetime; a stream (not a one-shot list<u8>) is what
    /// lets the parent write more input after the child has started reading.
    spawn: static func(name: string, args: list<string>, stdin: stream<u8>) -> result<child-process, exec-error>;

    /// The child's wasi:cli/stdout, readable by the parent.
    stdout: func() -> stream<u8>;

    /// Block until the child's wasi:cli/run entrypoint returns, yielding its
    /// exit code (0 = success, matching wasi:cli/run's own convention).
    wait: async func() -> s32;
  }
}

/// A component that spawns allowlisted child processes.
world exec-consumer {
  import exec;
}
