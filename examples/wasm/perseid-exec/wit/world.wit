package example:perseid-exec;

/// A Perseid whose VERDICT is a component the operator wired at launch.
///
/// ***THE ONLY WORLD ON THE FLEET THAT IS BOTH A PERSEID AND AN EXEC CONSUMER.***
/// `world perseid` (wit/reconcile/reconcile.wit) does not import
/// `periapsis:host/exec`, and it should not - the exec seam is a HOST capability,
/// not a reconcile one, so it is named here rather than widened into the world
/// every Perseid gets. A program that wants both declares both, which is exactly
/// what `spec.capabilities` then has to grant.
///
/// ⚠ The reconcile imports are a SUBSET of `world perseid` on purpose. A world
/// that imports what it does not call still has to be GRANTED it
/// (`spec.capabilities`), so importing the full set would ask an operator for
/// authority this program never exercises.
world perseid-exec {
  // The subject read. `observe` is the only route to an object - see
  // `interface observe-configmaps`, which is deliberately EMPTY because a second
  // name-only route would reintroduce two ways to read one thing.
  import perseid:reconcile/observe@0.1.0;
  // The verdict this program publishes. Three-valued, like the read.
  import perseid:reconcile/status@0.1.0;

  // The checker. `--exec-with <name>=<path>` at pod launch decides which
  // component `spawn("check", ...)` reaches; an undeclared name is `not-allowed`
  // and there is no way to name a host path from in here.
  import periapsis:host/exec@0.1.0;

  export perseid:reconcile/step@0.1.0;

  // ⛔ ***WITHOUT THIS TRAIL REFUSES TO SERVE THE PROGRAM, AND THE REFUSAL IS
  // CORRECT.*** Measured live 2026-09-08: *"this program imports 2 and exports no
  // perseid:reconcile/signal@0.1.0. A program that reads can WEDGE - every read
  // is a round trip to radiant, and one that is never answered leaves the step
  // suspended with no way out."*
  //
  // So a Perseid that performs I/O must export `signal` and race a `future<u32>`
  // against its reads. The TS arm gets this from the SDK's `wakeable()`; here it
  // is hand-written, and `../perseid-wake-rs` is the reference for the mechanism.
  //
  // ⚠ The world BUILT and INSPECTED cleanly without it - `wasm-tools validate`
  // passes, `trail --inspect` reports the intended surface - so nothing short of
  // actually serving the component could have found this.
  export perseid:reconcile/signal@0.1.0;
}
