{
  "name": "@apsis-io/periapsis-sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for Periapsis's periapsis:* WASI component-model interfaces (identity, config, log, metrics, status, checkpoint, exec, magic-seam RPC) - for WASM components built with dwarf (WASI 0.3/Preview 3, QuickJS) and run under the trail runtime.",
  "keywords": [
    "periapsis",
    "wasi",
    "component-model",
    "wasm",
    "dwarf",
    "preview3"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apsis-io/sdk.git",
    "directory": "ts/periapsis"
  },
  "type": "module",
  "scripts": {
    "test": "bun test"
  },
  "files": [
    "*.ts",
    "types",
    "fetch-provider",
    "!fetch-provider/*.wasm",
    "README.md",
    "CHEATSHEET.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.ts",
    "./*.js": "./*.ts",
    "./*": "./*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/bun": "latest",
    "typescript": "7.0.1-rc"
  }
}
