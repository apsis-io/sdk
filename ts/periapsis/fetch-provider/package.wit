package dwarf:fetch;

// Interface-only fragment of dwarf's examples/fetch-provider/package.wit -
// deliberately WITHOUT the `world fetch-provider { import wasi:http/client@
// 0.3.0; export client; }` wrapper, since that import requirement belongs to
// the fetch-provider component itself, not to whatever consumes it. Vendor
// this fragment into a consumer's own wit/deps/dwarf-fetch/package.wit and
// `import dwarf:fetch/client;` in its world - see fetch.ts/README.md.
interface client {
  record http-header {
    name: string,
    value: string,
  }

  record fetch-request {
    url: string,
    method: string,
    headers: list<http-header>,
    body: option<list<u8>>,
  }

  record fetch-response {
    status: u16,
    headers: list<http-header>,
    body: list<u8>,
  }

  fetch: async func(request: fetch-request) -> result<fetch-response, string>;
}
