{
  "name": "@apsis-io/perseid",
  "version": "0.4.0",
  "description": "The Perseid vocabulary for TypeScript guests: the ADR-0075 reconciliation step contract, the aperture expression language, resume conditions, invariants, backstop and wake. The ts half of the apsis-perseid crate's vocabulary - importing it obliges no periapsis:* interface.",
  "keywords": [
    "perseid",
    "periapsis",
    "kubernetes",
    "wasm",
    "expression",
    "operator",
    "component-model"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apsis-io/sdk.git",
    "directory": "ts/perseid"
  },
  "type": "module",
  "scripts": {
    "test": "bun test"
  },
  "files": [
    "*.ts",
    "!*.test.ts",
    "README.md",
    "QUICKSTART.md",
    "LICENSE"
  ],
  "exports": {
    "./*.js": "./*.ts",
    "./*": "./*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/bun": "latest",
    "typescript": "7.0.1-rc"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52"
  }
}
